{
  "name": "nyx",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "images": "node scripts/optimize-images.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "postbuild": "node scripts/inject-dist.mjs && node scripts/csp-hashes.mjs",
    "lint": "ng lint",
    "test:watch": "ng test",
    "env": "node scripts/set-env.mjs",
    "prestart": "node scripts/set-env.mjs",
    "prebuild": "node scripts/set-env.mjs --production",
    "pretest": "node scripts/set-env.mjs",
    "prelint": "node scripts/set-env.mjs",
    "test:coverage": "ng test --watch=false --coverage",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:scripts": "node --test scripts/test/env.test.mjs scripts/test/postbuild.test.mjs",
    "e2e:build": "node scripts/e2e-build.mjs",
    "e2e": "npm run e2e:build && playwright test --grep-invert @visual",
    "e2e:only": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --project=visual",
    "e2e:report": "playwright show-report",
    "lhci": "npx -y @lhci/cli@0.15.1 autorun",
    "test:all": "npm run lint && npm test && npm run test:scripts && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
