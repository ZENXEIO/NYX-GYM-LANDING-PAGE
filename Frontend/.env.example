# Copy to .env and fill in. PUBLIC values only: everything here ends up in the
# browser bundle. Never put secrets (API keys with write access, Turnstile
# SECRET key, DB passwords) in this file — those belong to the form endpoint.
#
# Host env vars (e.g. Cloudflare Pages → Settings → Variables) override .env.
# Production builds fail on placeholder values when CI=true or NYX_STRICT=true.

# Canonical origin, no trailing slash (canonical URLs, OG tags, sitemap, JSON-LD)
NYX_SITE_URL=https://nyx.example

# Tour form endpoint (CLAUDE.md §10). Empty = demo mode in dev, phone fallback in prod.
NYX_TOUR_ENDPOINT=

# Cloudflare Turnstile SITE key (public). Empty = widget not loaded.
NYX_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token. Empty = no analytics.
NYX_CF_ANALYTICS_TOKEN=

# Club contact details (shown in header, footer, form fallback and JSON-LD)
NYX_PHONE=+910000000000
NYX_PHONE_DISPLAY=+91 00000 00000
NYX_EMAIL=hello@nyx.example
NYX_INSTAGRAM_URL=https://instagram.com/
